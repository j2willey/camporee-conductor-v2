# Keep secrets, local databases and build output out of the image.
.git
**/node_modules
**/dist
**/test-results
**/playwright-report
# At any depth: patterns without **/ only match at the build root, and apps/*/ hold dev databases.
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3

# The on-site box's backups and cartridges: people's names and emails (issue #40).
deploy/collator/backups
deploy/collator/cartridges
