# Copy to deploy/collator/.env (gitignored) and edit. Variables set on the command line win over the file.

# Event day: certificate files, both compose files. Leave COMPOSE_FILE unset for TLS_MODE=internal (dev).
COMPOSE_FILE=compose.yaml:compose.tls-files.yaml
# Where issue-cert.sh wrote fullchain.pem and privkey.pem: outside the repo.
CERTS_DIR=/home/jim/collator-certs

# The name phones use; the router's local DNS points it at this box.
COLLATOR_HOSTNAME=judge.camporeeconductor.com
HTTPS_PORT=443
HTTP_PORT=80

# The USB stick (or any folder), writable by uid 1000. Backups every BACKUP_EVERY_MINUTES, newest BACKUP_KEEP kept.
BACKUP_HOST_DIR=/media/jim/COLLATOR
BACKUP_EVERY_MINUTES=5
BACKUP_KEEP=288

# Where you put the event-day cartridge to load (mounted read-only at /cartridges).
CARTRIDGES_DIR=./cartridges

# Loading the event-day cartridge from the Official page (ADR-0027, provisional; #100).
# Once an Event is loaded, only a signed-in Director can load. On an empty box, the first load needs a setup code:
# SETUP_CODE below, or, when it's blank, a code the box makes up at start and prints in its log
# (docker compose logs collator | grep "setup code"). A SETUP_CODE needs at least 16 letters or digits. A code is
# spent by the first load, until the box restarts; after 5 wrong tries an address has to wait.
# FIRST_LOAD=open needs no code: ONLY for a box with no internet (it logs a WARNING and the page says so).
FIRST_LOAD=code
SETUP_CODE=
